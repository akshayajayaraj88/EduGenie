# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Any current Gemini model from https://ai.google.dev/gemini-api/docs/models
# gemini-3.5-flash-lite is cheaper and faster if you hit limits.
GEMINI_MODEL=gemini-3.8-flash
# Used automatically if the main model is overloaded (set to none to disable)
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Seconds to wait for Gemini, and how much it "thinks" (minimal/low/medium/high)
GEMINI_TIMEOUT=45
GEMINI_THINKING=low

# Set to true (after: pip install -r requirements-local.txt) to run
# explanations on the local LaMini-Flan-T5 model instead of Gemini.
USE_LOCAL_MODEL=false
