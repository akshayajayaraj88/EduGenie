# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-api-key-here

# Any current Gemini model from https://ai.google.dev/gemini-api/docs/models
# gemini-3.5-flash-lite is cheaper and faster if you hit limits.
GEMINI_MODEL=gemini-3.8-flash

# Set to true (after: pip install -r requirements-local.txt) to run
# explanations on the local LaMini-Flan-T5 model instead of Gemini.
USE_LOCAL_MODEL=false
